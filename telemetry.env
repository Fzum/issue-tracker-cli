# Live traces for a wave. Source this in the shell you run `orchestrate` from:
#
#     . /path/to/issue-tracker-cli/telemetry.env
#
# Every spawned agent is *already* tagged with `wp.id=<its work package>`, on
# every run, with no flag and no config. These variables are only what tells
# Claude Code where to send the telemetry. Full reference — the viewer, the
# version floor, what to look at: docs/observability.md
#
# This is deliberately not a project file and `install.sh` deliberately does not
# write one. "Is my viewer running?" is a question about this afternoon, not
# about the repository, so it is answered per shell — where the viewer is, and
# nowhere else. If nothing is listening, the exporter fails quietly and the
# agents work as normal.

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_TRACES_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_METRICS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Metrics default to a 60 s export interval, which is longer than some agents
# live. These are the values to watch a live run with.
export OTEL_METRIC_EXPORT_INTERVAL=5000
export OTEL_LOGS_EXPORT_INTERVAL=1000

# Turns a `Bash` span into the actual command that ran, which is most of the
# value of watching a wave at all.
export OTEL_LOG_TOOL_DETAILS=1

# Opt-in, and commented out on purpose: these put whole prompts and whole
# replies into the collector. Uncomment knowingly.
# export OTEL_LOG_USER_PROMPTS=1
# export OTEL_LOG_ASSISTANT_RESPONSES=1
